{
  "name": "city-weather-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.json *.ts",
    "format:check": "prettier --check src e2e *.json *.ts"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
