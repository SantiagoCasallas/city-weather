{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist/out-tsc",
    "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
